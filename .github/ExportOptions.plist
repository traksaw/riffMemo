<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Read by `xcodebuild -exportArchive` in .github/workflows/testflight.yml. -->
	<key>method</key>
	<string>app-store-connect</string>
	<!-- `upload` sends the build straight to App Store Connect, so no
	     separate altool/Transporter step is needed. -->
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>WS5JAZ98FC</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<!-- The workflow sets the build number itself (github.run_number).
	     Without this, Xcode may silently replace it during export. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
